generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EstadoOng {
  HABILITADA
  SUSPENDIDA
  BAJA
}

enum EstadoCompromiso {
  ACTIVO
  LIBERADO
}

model Ong {
  id           Int       @id @default(autoincrement())
  razonSocial  String
  descripcion  String?
  sigla        String    @unique
  cuit         String    @unique
  estado       EstadoOng @default(HABILITADA)
  recursos     OngRecurso[]
}

model Recurso {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  codigo      String   @unique
  categoriaId Int
  categoria   Categoria @relation(fields: [categoriaId], references: [id])
  ongs        OngRecurso[]
}

model OngRecurso {
  ongId       Int
  ong         Ong     @relation(fields: [ongId], references: [id])

  recursoId   Int
  recurso     Recurso @relation(fields: [recursoId], references: [id])

  cantidadTotal        Int
  cantidadReservada Int @default(0)

  compromisos Compromiso[]

  @@id([ongId, recursoId])
}

model Compromiso {
  id                     Int              @id @default(autoincrement())

  detalleAdjudicacionRef Int              @unique

  cantidad               Int
  estado                 EstadoCompromiso @default(ACTIVO)

  fechaCompromiso        DateTime         @default(now())
  fechaLiberacion        DateTime?

  ongId                   Int
  recursoId               Int

  ongRecurso OngRecurso @relation(fields: [ongId, recursoId], references: [ongId, recursoId])

  @@index([ongId, recursoId])
}

model Categoria {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  descripcion String?
  codigo      String   @unique
  recursos    Recurso[]
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}